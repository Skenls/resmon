# ResMon Web Environment Configuration
PORT=8080
BIND_ADDR=127.0.0.1
HOST=0.0.0.0
UPDATE_INTERVAL=1.0
HISTORY_POINTS=900
MAX_WS_CLIENTS=100
HOST_PROC=/host/proc
HOST_SYS=/host/sys
LOG_LEVEL=info

# Authentication (HTTP Basic Auth + Native Browser Dialog)
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Generate with: openssl rand -base64 24
AUTH_PASSWORD=replace_with_a_long_random_password
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_random_secret_hex
COOKIE_SECURE=false

# MCP (read-only HTTP endpoint at /mcp)
MCP_ENABLED=false
# Generate with: openssl rand -hex 32; empty key keeps MCP disabled
MCP_API_KEY=
