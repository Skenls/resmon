# ResMon Web Environment Configuration
PORT=8080
HOST=0.0.0.0
UPDATE_INTERVAL=1.0
HISTORY_POINTS=900
HOST_PROC=/host/proc
HOST_SYS=/host/sys
LOG_LEVEL=info

# Authentication (HTTP Basic Auth + Native Browser Dialog)
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme_to_a_strong_password
SECRET_KEY=change_this_to_a_random_secret_key_for_sessions
